{
  "name": "palot-2",
  "version": "0.14.1",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "package:nightly:linux": "bun run --cwd apps/desktop package:nightly:linux",
    "package:verify:linux": "bun run --cwd apps/desktop package:verify:linux",
    "package:arch": "bun run --cwd apps/desktop package:arch",
    "install:nightly:linux": "bun run --cwd apps/desktop install:nightly:linux",
    "linux:doctor": "bun run --cwd apps/desktop linux:doctor",
    "dev": "vp run --filter @palot/desktop dev",
    "dev:focus": "vp run --filter @palot/desktop dev:focus",
    "dev:visible": "vp run --filter @palot/desktop dev:visible",
    "dev:scan": "vp run --filter @palot/desktop dev:scan",
    "dev:info": "bun apps/desktop/scripts/dev-info.ts",
    "dev:restart": "bun run --cwd apps/desktop dev:restart",
    "build": "vp run --filter @palot/desktop build",
    "icons:generate": "bun run --cwd apps/desktop icons:generate",
    "icons:check": "bun run --cwd apps/desktop icons:check",
    "opencode:coverage": "bun run --cwd apps/desktop opencode:coverage",
    "opencode:coverage:check": "bun run --cwd apps/desktop opencode:coverage:check",
    "release:verify-config": "bun run --cwd apps/desktop release:verify-config",
    "release:metadata": "bun run --cwd apps/desktop release:metadata",
    "runtime:stage:mac": "bun run --cwd apps/desktop runtime:stage:mac",
    "test": "vp run --filter @palot/desktop test",
    "test:e2e": "bun run --cwd apps/desktop test:e2e",
    "test:e2e:list": "bun run --cwd apps/desktop test:e2e:list",
    "showcase": "bun run --cwd apps/desktop showcase",
    "demo": "bun run --cwd apps/desktop demo",
    "perf:doctor": "vp dlx react-doctor@0.9.14 apps/desktop --scope changed --include-untracked --blocking none --no-score --no-supply-chain",
    "perf:doctor:full": "vp dlx react-doctor@0.9.14 apps/desktop --scope full --blocking none --no-score --no-supply-chain",
    "perf:react-check": "vp exec -- oxlint apps/desktop/src/renderer -c apps/desktop/oxlint.react-compiler.json",
    "perf:compiler": "vp run --filter @palot/desktop build:renderer:compiler",
    "perf:compiler:annotation": "vp run --filter @palot/desktop build:renderer:compiler:annotation",
    "perf:e2e": "bun run test:e2e -- session-switch-performance --profile",
    "perf:selectors": "bun run test:e2e -- session-switch-performance --profile --css-selector-stats",
    "perf:trace": "bun run test:e2e -- session-switch-performance --trace --react-profile",
    "perf:parallel": "bun run test:e2e -- parallel-session-performance --profile",
    "perf:input": "bun run test:e2e -- input-streaming-performance --profile",
    "perf:input:video": "bun run test:e2e -- input-streaming-performance --profile --video",
    "perf:interactions": "bun run test:e2e -- interaction-streaming-performance --profile",
    "perf:batch:steady": "bun run test:e2e -- batch-input-steady --profile",
    "perf:batch:burst": "bun run test:e2e -- batch-input-burst --profile",
    "perf:stability": "bun run test:e2e -- streaming-bottom-follow-stability --profile",
    "perf:stability:video": "bun run test:e2e -- streaming-bottom-follow-stability --profile --video",
    "perf:compare": "bun apps/desktop/scripts/perf-compare.ts",
    "perf:parallel:memory": "bun run test:e2e -- parallel-session-memory --profile",
    "perf:parallel:trace": "bun run test:e2e -- parallel-session-performance --app-trace",
    "perf:scan:render": "bun run test:e2e -- render-react-scan --react-scan --react-profile",
    "typecheck": "vp run --filter @palot/desktop typecheck",
    "check": "bun run format:check && bun run lint && bun run --cwd packages/orbits check-types && bun run typecheck && bun run opencode:coverage:check && bun run test",
    "lint": "vp lint --report-unused-disable-directives",
    "format": "vp fmt --ignore-path .formatignore",
    "format:check": "vp fmt --check --ignore-path .formatignore",
    "package": "vp run --filter @palot/desktop package",
    "package:mac": "vp run --filter @palot/desktop package:mac",
    "package:verify:mac": "bun run --cwd apps/desktop package:verify:mac",
    "package:nightly:mac": "bun run --cwd apps/desktop package:nightly:mac",
    "package:verify:nightly:mac": "bun run --cwd apps/desktop package:verify:nightly:mac",
    "package:smoke:nightly:mac": "bun run --cwd apps/desktop package:smoke:nightly:mac",
    "setup:signing:mac": "bun run --cwd apps/desktop setup:signing:mac",
    "install:nightly:mac": "bun run --cwd apps/desktop install:nightly:mac",
    "install:nightly:full:mac": "bun run --cwd apps/desktop install:nightly:full:mac",
    "clean": "vp run --filter @palot/desktop clean"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.82.0",
    "vite-plus": "0.3.1"
  },
  "overrides": {
    "@shikijs/core": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "@shikijs/transformers": "4.4.3",
    "@shikijs/types": "4.4.3",
    "katex": "0.18.7",
    "shiki": "4.4.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1"
  },
  "engines": {
    "bun": "1.4.2",
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "electron",
    "electron-builder",
    "electron-winstaller",
    "msgpackr-extract",
    "msw",
    "objc-js"
  ]
}
