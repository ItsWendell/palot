{
  "name": "@palot/desktop",
  "version": "0.12.0",
  "private": true,
  "description": "Palot 2 desktop client for OpenCode 2",
  "homepage": "https://github.com/ItsWendell/palot",
  "license": "MIT",
  "author": "Palot contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsWendell/palot.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "package:nightly:linux": "bun scripts/linux-package.ts build nightly",
    "package:verify:linux": "bun scripts/linux-package.ts verify nightly",
    "package:arch": "bun scripts/linux-package.ts arch nightly",
    "install:nightly:linux": "bun scripts/linux-package.ts install nightly",
    "linux:doctor": "bun scripts/linux-doctor.ts",
    "dev": "bun run scripts/dev.ts",
    "dev:focus": "bun run scripts/dev.ts --focus",
    "dev:visible": "bun run scripts/dev.ts --visible",
    "dev:scan": "PALOT_REACT_SCAN=1 bun run scripts/dev.ts",
    "dev:info": "bun run scripts/dev-info.ts",
    "dev:restart": "bun run scripts/dev-restart.ts",
    "build": "bun run scripts/build.ts",
    "build:main": "bun x vite build --config vite.main.config.ts",
    "build:preload": "bun x vite build --config vite.preload.config.ts",
    "build:renderer": "bun x vite build --config vite.renderer.config.ts",
    "build:renderer:compiler": "PALOT_REACT_COMPILER=infer bun run scripts/build.ts --renderer-only",
    "build:renderer:compiler:annotation": "PALOT_REACT_COMPILER=annotation bun run scripts/build.ts --renderer-only",
    "build:renderer:profiling": "PALOT_REACT_PROFILING=1 bun run scripts/build.ts --renderer-only",
    "icons:generate": "bun run scripts/generate-icons.ts",
    "icons:check": "bun run scripts/generate-icons.ts --check",
    "opencode:coverage": "bun run scripts/opencode-coverage.ts",
    "opencode:coverage:check": "bun run scripts/opencode-coverage.ts --check",
    "release:verify-config": "bun run scripts/release-build-info.ts",
    "release:metadata": "bun run scripts/unsigned-release-metadata.ts",
    "runtime:stage:mac": "bun run scripts/stage-opencode-runtime.ts",
    "generate:routes": "tsr generate",
    "db:generate": "drizzle-kit generate",
    "tanstack": "tanstack",
    "test": "vp test run --passWithNoTests",
    "test:e2e": "node --experimental-strip-types scripts/e2e.ts",
    "test:e2e:list": "node --experimental-strip-types scripts/e2e.ts --list",
    "showcase": "node --experimental-strip-types scripts/showcase.ts",
    "typecheck": "tsc -b --pretty false",
    "check": "vp check . && bun run typecheck && bun run opencode:coverage:check && bun run test",
    "package": "bun run scripts/package.ts stable",
    "package:mac": "bun run scripts/package.ts stable --mac",
    "package:verify:mac": "bun run scripts/release-verification.ts stable",
    "package:nightly:mac": "bun run scripts/package.ts nightly --mac",
    "package:verify:nightly:mac": "bun run scripts/release-verification.ts nightly",
    "package:smoke:nightly:mac": "bun run scripts/release-verification.ts nightly --smoke",
    "setup:signing:mac": "sh scripts/setup-local-signing.sh",
    "install:nightly:mac": "bun run scripts/install-nightly-mac.ts",
    "install:nightly:full:mac": "bun run scripts/install-nightly-mac.ts --full",
    "clean": "bun run scripts/clean.ts"
  },
  "dependencies": {
    "date-fns-tz": "3.2.0",
    "electron-log": "5.4.4",
    "electron-store": "11.0.2",
    "katex": "0.18.6",
    "mermaid": "11.17.2",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@base-ui/react": "1.8.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@electron/fuses": "2.1.3",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fira-code": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@opencode/client": "2.0.2",
    "@opencode/protocol": "2.0.2",
    "@palot/orbits": "workspace:*",
    "@pierre/diffs": "1.4.1",
    "@pierre/theming": "1.0.1",
    "@pierre/trees": "1.0.0-beta.6",
    "@playwright/test": "1.62.1",
    "@resvg/resvg-js": "2.6.2",
    "@rolldown/plugin-babel": "0.2.3",
    "@shadcn/react": "0.3.0",
    "@shikijs/stream": "4.4.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/charts": "0.15.0",
    "@tanstack/cli": "0.70.2",
    "@tanstack/db": "0.8.7",
    "@tanstack/highlight": "0.0.10",
    "@tanstack/markdown": "0.0.13",
    "@tanstack/query-db-collection": "1.2.12",
    "@tanstack/react-db": "0.3.7",
    "@tanstack/react-query": "5.102.6",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-virtual": "3.14.10",
    "@tanstack/router-cli": "1.167.33",
    "@tanstack/router-plugin": "1.168.35",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.3.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "anser": "2.3.5",
    "babel-plugin-react-compiler": "1.0.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.2.5",
    "date-fns": "4.4.0",
    "drizzle-kit": "1.0.0-beta.22",
    "drizzle-orm": "1.0.0-beta.22",
    "effect": "4.0.0-rc.112",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "embla-carousel-react": "8.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fuzzysort": "4.0.2",
    "ghostty-web": "github:anomalyco/ghostty-web#83c0a07b8628b748aed073b232cb4b52a6ca11c1",
    "happy-dom": "20.11.6",
    "input-otp": "1.5.0",
    "jotai": "2.20.3",
    "lucide-react": "1.34.0",
    "motion": "13.1.1",
    "msw": "2.15.0",
    "oxc-parser": "0.147.0",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.12.3",
    "react-scan": "0.5.7",
    "rrule": "2.8.1",
    "shadcn": "4.19.0",
    "shiki": "4.4.3",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "valibot": "1.4.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vite-plus": "0.3.1",
    "vitest": "4.1.11"
  },
  "optionalDependencies": {
    "electron-liquid-glass": "workspace:*",
    "objc-js": "1.5.0"
  }
}
